{
  "name": "ultrateam-desktop",
  "productName": "ultrateam",
  "version": "0.1.0",
  "description": "Menu bar / tray app for ultrateam — shared memory for every coding agent",
  "type": "module",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "stage": "node scripts/stage-core.mjs",
    "dist": "node scripts/stage-core.mjs && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.spencervoorhees.ultrateam",
    "productName": "ultrateam",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "assets/**"
    ],
    "extraResources": [
      { "from": "core-staging", "to": "core", "filter": ["**/*"] }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
