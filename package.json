{
  "name": "ultrateam",
  "version": "0.1.0",
  "description": "Shared memory and session handoff for the team of coding agents on your machine",
  "type": "module",
  "bin": {
    "ultrateam": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test tests/schema.test.ts tests/jsonl.test.ts tests/db.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": "github:spencer-voorhees/ultrateam",
  "keywords": [
    "mcp",
    "coding-agents",
    "memory",
    "session-handoff",
    "claude-code",
    "cursor",
    "copilot"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^14.0.0",
    "ulid": "^3.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
